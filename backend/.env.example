# Local development defaults. Override these in the hosting provider.
APP_NAME=SpendWise AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Replace with your local or managed PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://spendwise_user:YOUR_PASSWORD@localhost:5432/spendwise_db

# Generate a unique secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON array. Add the exact deployed frontend origin in the hosting dashboard.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional: AI features are unavailable without a valid key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
